# Copy this file to .env before running the server.
# Everything below has a safe default for local development / demos -
# the server runs and every flow works end-to-end with zero configuration.
# Fill in real values when you have them to switch each piece from
# simulated to real, one at a time, with no code changes required.

# --- Core ---
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=4000

# First admin account, created automatically on `npm run seed`
ADMIN_EMAIL="admin@lafiya.cm"
ADMIN_PASSWORD="ChangeMe123!"

# --- Email (patient/doctor notifications) ---
# Leave empty to use an automatic Ethereal test inbox (real SMTP delivery,
# viewable via a preview link printed in the server logs - nothing reaches
# real patients yet, but the sending code path is genuinely exercised).
# Fill in to send through a real mailbox or provider (Gmail SMTP, SendGrid, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lafiya Sante <no-reply@lafiya.cm>"

# --- SMS (fallback channel when WhatsApp is unavailable) ---
# Leave empty to log a simulated send. Fill in with your SMS gateway's
# REST endpoint and key (most Cameroonian/regional aggregators expose a
# simple POST-with-API-key endpoint like this one).
SMS_GATEWAY_URL=
SMS_API_KEY=

# --- WhatsApp Business Platform (Meta Cloud API) ---
# Obtained from a Meta-approved Business Solution Provider or the Meta
# Business dashboard. Leave empty to log a simulated send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- MTN Mobile Money (Collection API) ---
# Get a free sandbox subscription key at https://momodeveloper.mtn.com
# Leave empty to use the built-in mock collector (auto-confirms after ~3s,
# matching the prototype's UX, so the booking flow still completes).
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"

# --- Orange Money (Web Payment API) ---
# Obtained from Orange Developer Center or an aggregator (CamerPay, Maviance).
# Leave empty to use the built-in mock collector.
ORANGE_MERCHANT_KEY=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_BASE_URL="https://api.orange.com"
