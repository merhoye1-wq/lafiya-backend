// Lafiya Sante - database schema
// Dev/demo: SQLite (zero setup). Production: switch provider to "postgresql"
// and point DATABASE_URL at a real Postgres instance - no other change needed
// as long as you re-run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   // "patient" | "doctor" | "admin"
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime @default(now())

  doctorProfile DoctorProfile?
  appointments  Appointment[] @relation("PatientAppointments")

  @@index([role])
}

model DoctorProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  specialty              String
  city                   String
  languages              String    // comma-separated, e.g. "FR,EN"
  modes                  String    // comma-separated, e.g. "presentiel,video,domicile"
  orderNumber            String    // ONMC registration number, pending manual verification
  consultationPriceFcfa  Int
  homeVisitPriceFcfa     Int?
  verificationStatus     String    @default("pending") // pending | approved | rejected
  verificationNote       String?
  verifiedAt             DateTime?

  createdAt   DateTime @default(now())
  appointments      Appointment[]     @relation("DoctorAppointments")
  documentsIssued   PatientDocument[]

  @@index([specialty])
  @@index([city])
  @@index([verificationStatus])
}

model Appointment {
  id          String   @id @default(cuid())
  patientId   String
  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      DoctorProfile @relation("DoctorAppointments", fields: [doctorId], references: [id])
  scheduledAt DateTime
  mode        String   // presentiel | video | domicile
  status      String   @default("pending_payment") // pending_payment | confirmed | cancelled | completed
  priceFcfa   Int
  addressJson String?  // JSON string: quartier/ville/tel/note, only for mode=domicile
  createdAt   DateTime @default(now())

  payment   Payment?
  documents PatientDocument[]

  @@unique([doctorId, scheduledAt]) // a doctor cannot be double-booked for the same instant
  @@index([patientId])
  @@index([status])
}

model Payment {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  method        String    // momo | orange | card
  phoneNumber   String?
  amountFcfa    Int
  status        String    @default("initiated") // initiated | pending_confirmation | confirmed | failed
  providerRef   String?
  mock          Boolean   @default(true) // true while no real operator credentials are configured
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?
}

model PatientDocument {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientEmail  String       // denormalized so a document can be attached even without a full patient account yet
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  kind          String       // results | prescription
  fileName      String
  filePath      String
  createdAt     DateTime     @default(now())

  @@index([patientEmail])
}
